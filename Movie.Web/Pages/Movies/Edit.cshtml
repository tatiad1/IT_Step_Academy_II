@page "{id:int}"
@model Movie.Web.Pages.Movies.EditModel
@{
    ViewData["Title"] = "Edit Movie";
}

<div class="movie-form-card card mx-auto">

    <div class="movie-form-header">
        <span class="movie-form-eyebrow">Edit movie</span>
        <h1 class="h2 mb-0">Update movie details</h1>
    </div>

    <div class="card-body p-4 p-md-5">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form method="post">

            <div class="mb-4">
                <label asp-for="Input.Title" class="form-label movie-form-label">Title</label>
                <input asp-for="Input.Title" class="form-control form-control-lg" placeholder="Enter movie title" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="Input.ReleaseYear" class="form-label movie-form-label">Release Year</label>
                    <input asp-for="Input.ReleaseYear" type="number" class="form-control" placeholder="Enter release year" />
                    <span asp-validation-for="Input.ReleaseYear" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.StudioId" class="form-label movie-form-label">Studio ID</label>
                    <input asp-for="Input.StudioId" type="number" class="form-control" placeholder="Enter studio ID" />
                    <span asp-validation-for="Input.StudioId" class="text-danger small"></span>
                    <div class="form-text">Current studio: <strong>@Model.CurrentStudioName</strong></div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="/Movies/Index" class="btn btn-reset">Cancel</a>
                <button type="submit" class="btn btn-movie">Update Movie</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}